# Database connection (SQLite)
DATABASE_URL="file:../data/snippetvault.db"

# AI Provider Configuration (Optional, can also be configured in Web UI Settings)
# AI_PROVIDER: "openai", "gemini", or "custom"
AI_PROVIDER="openai"
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# Port (used in Docker)
PORT=3000
