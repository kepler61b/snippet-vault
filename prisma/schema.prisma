datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  passwordHash     String
  name             String?
  bio              String?
  role             String       @default("USER") // "ADMIN" or "USER"
  isBanned         Boolean      @default(false)
  twoFactorEnabled Boolean      @default(false)
  twoFactorSecret  String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tokenVersion     Int          @default(0)

  snippets         Snippet[]
  collections      Collection[]
  passkeys         Passkey[]
  personalAccessTokens PersonalAccessToken[]
  integrationLogs  IntegrationLog[]
  auditLogs        AuditLog[]

  @@index([email])
  @@index([role])
}

model Collection {
  id          String        @id @default(uuid())
  name        String
  description String?
  iconType    String        @default("lucide") // "lucide" or "custom_image"
  iconValue   String        @default("Folder") // Lucide icon name (e.g. "Folder", "Terminal") or base64 data URL
  color       String?       @default("#8b5cf6")
  userId      String?
  user        User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Collection?   @relation("CollectionHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Collection[]  @relation("CollectionHierarchy")
  isSmart     Boolean       @default(false)
  filterRule  String?       // JSON encoded SmartFilterRule
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  snippets    Snippet[]

  @@index([userId])
  @@index([parentId])
  @@index([isSmart])
}

model Snippet {
  id           String        @id @default(uuid())
  title        String
  description  String?
  visibility   String        @default("PUBLIC") // "PUBLIC", "UNLISTED", "PRIVATE"
  shareToken   String        @unique @default(uuid())
  isFavorite   Boolean       @default(false)
  tags         String        @default("") // comma-separated tags: "react, hooks, ui"
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  userId       String?
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  collectionId String?
  collection   Collection?   @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  files        SnippetFile[]
  revisions    SnippetRevision[]

  @@index([visibility])
  @@index([isFavorite])
  @@index([createdAt])
  @@index([userId])
  @@index([collectionId])
}

model SnippetFile {
  id        String   @id @default(uuid())
  snippetId String
  filename  String
  language  String   @default("plaintext")
  content   String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  snippet   Snippet  @relation(fields: [snippetId], references: [id], onDelete: Cascade)

  @@index([snippetId])
  @@index([language])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Passkey {
  id           String    @id @default(uuid())
  name         String    @default("Passkey")
  credentialId String    @unique
  publicKey    String
  counter      Int       @default(0)
  deviceType   String?
  backedUp     Boolean   @default(false)
  transports   String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([credentialId])
}

model SnippetRevision {
  id          String   @id @default(uuid())
  snippetId   String
  title       String
  description String?
  tags        String   @default("")
  filesJson   String   // JSON encoded array of { filename, language, content, order }
  createdAt   DateTime @default(now())

  snippet     Snippet  @relation(fields: [snippetId], references: [id], onDelete: Cascade)

  @@index([snippetId])
  @@index([createdAt])
}

model PersonalAccessToken {
  id          String    @id @default(uuid())
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model IntegrationLog {
  id          String   @id @default(uuid())
  client      String
  action      String
  method      String
  path        String
  status      Int
  details     String?
  tokenPrefix String?
  ip          String?
  userAgent   String?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([status])
}

model AuditLog {
  id          String   @id @default(uuid())
  event       String   // e.g. "AUTH_LOGIN", "AUTH_FAILED", "USER_BANNED", "ROLE_CHANGED", "PASSWORD_RESET", "TOKEN_CREATED", "TOKEN_REVOKED", "SESSION_REVOKED", "TRANSFER_OWNERSHIP", etc.
  category    String   // "AUTH", "SECURITY", "ADMIN", "API"
  status      String   @default("SUCCESS") // "SUCCESS", "FAILURE", "WARNING", "INFO"
  actorId     String?
  actorEmail  String?
  targetId    String?
  targetEmail String?
  ip          String?
  userAgent   String?
  details     String?
  createdAt   DateTime @default(now())

  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([event])
  @@index([status])
  @@index([createdAt])
  @@index([actorId])
}


